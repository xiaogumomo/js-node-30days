# 复制这个文件成 .env，填上真值（.env 已被仓库根的 .gitignore 挡住，不会进 git）
# 跑法：node --env-file=.env scratch/01-first-call.js
DEEPSEEK_API_KEY=

# 向量化（embedding）用 SiliconFlow —— 跟 chat 不是同一个 key
SILICONFLOW_API_KEY=
# 下面这些可选 —— 不写就用代码里的默认值
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL=BAAI/bge-m3
