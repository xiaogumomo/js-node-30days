# 复制这个文件成 .env，填上真值（.env 已被仓库根的 .gitignore 挡住，不会进 git）
# 跑法：node --env-file=.env scratch/01-first-call.js
DEEPSEEK_API_KEY=

# 向量化（embedding）—— 现在用智谱（智谱的 key 形如 id.secret，**没有 sk- 前缀是正常的**）
EMBED_API_KEY=

# 下面这些可选 —— 不写就用代码里的默认值
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBED_MODEL=embedding-3
